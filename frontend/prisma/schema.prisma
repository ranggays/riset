generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Annotation {
  id              String        @id @default(uuid())
  userId          String?
  articleId       String?
  page            Int
  highlightedText String
  comment         String
  semanticTag     String?
  draftSectionId  String?
  createdAt       DateTime      @default(now())
  Article         Article?      @relation(fields: [articleId], references: [id])
  DraftSection    DraftSection? @relation(fields: [draftSectionId], references: [id])
  User            User?         @relation(fields: [userId], references: [id])
}

model Article {
  id                   String                @id
  title                String
  filePath             String
  createdAt            DateTime              @default(now())
  updateAt             DateTime
  userId               String?
  sessionId            String?
  abstract             String?
  author               String?
  doi                  String?
  keywords             String?
  year                 String?
  Annotation           Annotation[]
  BrainstormingSession BrainstormingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User                 User?                 @relation(fields: [userId], references: [id])
  Edge                 Edge[]
  Node                 Node[]
}

model Assignment {
  id                   String                 @id
  title                String
  description          String
  week_number          Int
  assignment_code      String
  file_url             String?
  file_name            String?
  due_date             DateTime?
  is_active            Boolean                @default(true)
  created_by           String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  target_classes       String?
  User                 User                   @relation(fields: [created_by], references: [id], onDelete: Cascade)
  AssignmentSubmission AssignmentSubmission[]

  @@index([is_active])
  @@index([week_number])
}

model AssignmentSubmission {
  id                    String           @id
  assignment_id         String
  student_id            String
  assignment_code_input String
  file_url              String?
  file_name             String?
  submission_text       String?
  status                SubmissionStatus @default(pending)
  grade                 Int?
  feedback              String?
  submitted_at          DateTime         @default(now())
  graded_at             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime
  Assignment            Assignment       @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  User                  User             @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([assignment_id])
  @@index([status])
  @@index([student_id])
}

model BrainstormingSession {
  id                     String          @id  @default(uuid())
  title                  String
  description            String?
  userId                 String
  selectedFilterArticles String[]        @default([])
  lastSelectedNodeId     String?
  lastSelectedEdgeId     String?
  graphFilters           Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  lastActivity           DateTime        @default(now())
  coverColor             String          @default("#4c6ef5")
  Article                Article[]
  User                   User            @relation(fields: [userId], references: [id])
  ChatMessage            ChatMessage[]
  GazeEvent              GazeEvent[]
  TokenUsage             TokenUsage[]
  WriterSession          WriterSession[]
}

model ChatMessage {
  id                   String               @id
  sessionId            String
  content              String
  role                 String
  createdAt            DateTime             @default(now())
  contextEdgeIds       String[]             @default([])
  contextNodeIds       String[]             @default([])
  references           Json?
  BrainstormingSession BrainstormingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Draft {
  id            String         @id
  userId        String?
  title         String
  createdAt     DateTime       @default(now())
  writerId      String?
  User          User?          @relation(fields: [userId], references: [id])
  WriterSession WriterSession? @relation(fields: [writerId], references: [id], onDelete: Cascade)
  DraftSection  DraftSection[]
}

model DraftSection {
  id         String       @id
  draftId    String
  title      String
  content    String
  Annotation Annotation[]
  Draft      Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model Edge {
  id                     String  @id
  fromId                 String
  toId                   String
  relation               String?
  label                  String?
  color                  String?
  articleId              String
  Article                Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  Node_Edge_fromIdToNode Node    @relation("Edge_fromIdToNode", fields: [fromId], references: [id], onDelete: Cascade)
  Node_Edge_toIdToNode   Node    @relation("Edge_toIdToNode", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, relation])
}

model GazeEvent {
  id                   String               @id
  createdAt            DateTime             @default(now())
  gazeData             Json
  screenshotPath       String?
  sessionId            String
  BrainstormingSession BrainstormingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Node {
  id                     String  @id
  label                  String
  title                  String?
  att_goal               String?
  att_method             String?
  att_background         String?
  att_future             String?
  att_gaps               String?
  att_url                String?
  type                   String
  content                String
  articleId              String
  Edge_Edge_fromIdToNode Edge[]  @relation("Edge_fromIdToNode")
  Edge_Edge_toIdToNode   Edge[]  @relation("Edge_toIdToNode")
  Article                Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model TokenUsage {
  id                   String                @id
  userId               String
  sessionId            String?
  tokensUsed           Int
  inputTokens          Int                   @default(0)
  outputTokens         Int                   @default(0)
  model                String
  purpose              String
  metadata             Json?
  createdAt            DateTime              @default(now())
  BrainstormingSession BrainstormingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
}

model User {
  id                   String                 @id
  email                String                 @unique
  name                 String?
  password             String
  role                 Role                   @default(USER)
  createdAt            DateTime               @default(now())
  updateAt             DateTime
  group                String?
  nim                  String?
  avatar_url           String?
  phone                String?
  bio                  String?
  university           String?
  faculty              String?
  major                String?
  semester             Int?
  address              String?
  birthDate            String?
  linkedin             String?
  github               String?
  website              String?
  isEmailVerified      Boolean?               @default(false)
  isPhoneVerified      Boolean?               @default(false)
  lastActive           DateTime?
  token_balance        Int?                   @default(0)
  settings             Json?
  Annotation           Annotation[]
  Article              Article[]
  Assignment           Assignment[]
  AssignmentSubmission AssignmentSubmission[]
  BrainstormingSession BrainstormingSession[]
  Draft                Draft[]
  TokenUsage           TokenUsage[]
  WriterSession        WriterSession[]
  XapiStatement        XapiStatement[]
  analytics            analytics[]
}

model WriterSession {
  id                     String                @id
  title                  String
  description            String?
  userId                 String
  brainstormingSessionId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime
  lastActivity           DateTime              @default(now())
  coverColor             String                @default("#4c6ef5")
  Draft                  Draft[]
  BrainstormingSession   BrainstormingSession? @relation(fields: [brainstormingSessionId], references: [id])
  User                   User                  @relation(fields: [userId], references: [id])
}

model XapiStatement {
  id        String   @id
  actor     Json
  verb      Json
  object    Json
  result    Json?
  context   Json?
  timestamp DateTime @default(now())
  userId    String?
  sessionId String?
  sequence  Int?
  User      User?    @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([timestamp])
  @@index([userId])
}

model analytics {
  id        Int      @id @default(autoincrement())
  action    String
  document  String?
  userId    String
  metadata  Json?
  timestamp DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model documents {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content    String
  metadata   Json                   @default("{}")
  embedding  Unsupported("vector")?
  created_at DateTime               @default(now()) @db.Timestamptz(6)
}

enum Role {
  USER
  ADMIN
}

enum SubmissionStatus {
  pending
  submitted
  graded
}
